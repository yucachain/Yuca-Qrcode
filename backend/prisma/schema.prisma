// YucaChain Prisma Schema
// Database: SQLite (zero-setup for local dev, easy to migrate to PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CassavaBatch {
  id                String   @id
  consignmentId     String   @unique
  companyName       String
  variety           String
  moistureContent   Float
  cyanideContent    Float
  weight            Float
  weightUnit        String   // kg | tonnes | bags
  averageWeight     Float
  averageWeightUnit String   // kg | g
  entryDate         String
  exitDate          String
  hubLocation       String
  remark            String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
